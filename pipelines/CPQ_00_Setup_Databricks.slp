          "label": {
            "value": "Report catalog and row counts"
          }
        },
        "settings": {
          "sqlStatement": {
            "value": "\"SELECT current_catalog() AS current_catalog, current_user() AS run_as, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows) AS silver_rows, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_control) AS control_rows, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_audit) AS audit_rows\"",
