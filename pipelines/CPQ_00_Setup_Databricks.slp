    "dad90ae5-f543-4bd3-b064-a2deaf8f93d6": {
      "class_fqid": "com-snaplogic-snaps-databricks-multiexecute_1-UNKNOWN",
      "class_id": "com-snaplogic-snaps-databricks-multiexecute",
      "class_version": 1,
