            }
          }
        },
        "info": {
          "notes": {
            "value": null
          },
          "label": {
            "value": "Create schemas, tables and views"
          }
        },
        "settings": {
          "executable_during_suggest": {
            "value": false
          },
          "sqlStatements": {
            "value": [
              {
                "sqlStatement": {
                  "value": "_rebuild == 'true' ? (\"DROP SCHEMA IF EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver CASCADE\") : \"SELECT 1\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "_rebuild == 'true' ? (\"DROP SCHEMA IF EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw CASCADE\") : \"SELECT 1\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "_rebuild == 'true' ? (\"DROP SCHEMA IF EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops CASCADE\") : \"SELECT 1\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE SCHEMA IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw COMMENT 'Oracle CPQ change log (bronze)'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE SCHEMA IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver COMMENT 'Oracle CPQ current state (silver)'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE SCHEMA IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops COMMENT 'Oracle CPQ sync staging, control and audit'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE TABLE IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot (run_id STRING, object_name STRING, cpq_id STRING, payload STRING, business_key STRING, row_hash STRING) COMMENT 'Per-run landing area for full CPQ snapshots'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE TABLE IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes (run_id STRING, object_name STRING, business_key STRING, cpq_id STRING, op STRING, row_hash STRING, payload STRING, changed_at TIMESTAMP) COMMENT 'Append-only change log: op I (insert or undelete), U (update), D (delete)'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE TABLE IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows (object_name STRING, business_key STRING, cpq_id STRING, row_hash STRING, payload STRING, is_deleted BOOLEAN, deleted_at TIMESTAMP, first_seen_at TIMESTAMP, last_changed_at TIMESTAMP, last_run_id STRING) COMMENT 'Current state of every snapshot-synced CPQ object; soft deletes' TBLPROPERTIES (delta.enableChangeDataFeed = true)\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE TABLE IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_audit (run_id STRING, object_name STRING, finished_at TIMESTAMP, status STRING, expected_total BIGINT, staged_rows BIGINT, distinct_keys BIGINT, inserted_rows BIGINT, updated_rows BIGINT, deleted_rows BIGINT, would_delete BIGINT, deletes_allowed BOOLEAN, message STRING) COMMENT 'One row per object per sync run'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE TABLE IF NOT EXISTS \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_control (object_name STRING, last_run_id STRING, last_run_at TIMESTAMP, last_status STRING, last_message STRING, watermark STRING) COMMENT 'Latest sync state per object (watermark used later by quote syncs)'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE OR REPLACE VIEW \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.v_price_book AS SELECT CAST(cpq_id AS BIGINT) AS id, business_key AS variable_name, payload:['name'] AS name, payload:['description'] AS description, coalesce(payload:['status']['lookupCode'], payload:['status']) AS status_code, payload:['status']['displayValue'] AS status_display, CAST(payload:['dateAdded'] AS TIMESTAMP) AS date_added, CAST(payload:['dateModified'] AS TIMESTAMP) AS date_modified, CAST(payload:['orderNumber'] AS INT) AS order_number, is_deleted, deleted_at, first_seen_at, last_changed_at, last_run_id FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = 'PriceBook'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE OR REPLACE VIEW \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.v_custom_price AS SELECT business_key, CAST(cpq_id AS BIGINT) AS cpq_id, payload, is_deleted, deleted_at, first_seen_at, last_changed_at, last_run_id FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = 'CustomPrice'\"",
                  "expression": true
                }
              },
              {
                "sqlStatement": {
                  "value": "\"CREATE OR REPLACE VIEW \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.v_custom_discount AS SELECT business_key, CAST(cpq_id AS BIGINT) AS cpq_id, payload, is_deleted, deleted_at, first_seen_at, last_changed_at, last_run_id FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = 'CustomDiscount'\"",
                  "expression": true
                }
              }
            ]
          },
          "maxRetryProp": {
            "value": 0,
            "expression": false
          },
          "retryIntervalProp": {
            "value": 1,
            "expression": false
          },
          "sqlQueryManagement": {
            "value": "Continue to execute queued queries when pipeline is stopped or if it fails"
          },
          "sessionParamsProp": {
            "value": []
          }
        }
      },
      "class_build_tag": "UNKNOWN"
    },
