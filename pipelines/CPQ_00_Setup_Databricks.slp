                "label": "../../shared/Databricks_EMEA-SE_sql-warehouse-SERVERLESS",
                "expression": false
              },
              "ref_class_id": {
                "value": "com-snaplogic-snap-api-sql-accounts-databricks-databricksdatabaseaccount"
