354-4137-8c52-30ce805a63cf","instance_version":1,"property_map":{"account":{"account_ref":{"value":{}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"output":{"output0":{"label":{"value":"output0"},"view_type":{"value":"document"}}},"input":{"input0":{"label":{"value":"input0"},"view_type":{"value":"document"}}},"info":{"notes":{"value":null},"label":{"value":"Decide deletes and status"}},"settings":{"passThrough":{"value":true},"nullSafeAccess":{"value":false},"transformations":{"value":{"mappingRoot":{"value":"$"},"mappingTable":{"value":[{"expression":{"value":"$complete && ($within_guard || _forceDeletes == 'true')","expression":true},"targetPath":{"value":"$allow"}},{"expression":{"value":"!$complete ? 'OK_DELETES_DEFERRED_INCOMPLETE' : (($within_guard || _forceDeletes == 'true') ? 'OK' : 'OK_DELETES_BLOCKED_GUARD')","expression":true},"targetPath":{"value":"$status"}},{"expression":{"value":"'expected=' + $expected + ' staged=' + $staged_rows + ' distinct_keys=' + $distinct_keys + ' active=' + $active_rows + ' would_delete=' + $would_delete + ($distinct_keys != $staged_rows ? ' WARNING duplicate business keys - check keyColumns' : '')","expression":true},"targetPath":{"value":"$message"}}]}}},"omitExpressionIfMissing":{"value":false}}},"class_build_tag":"UNKNOWN"},"563f5916-c307-4270-b99e-f507174a3f14":{"class_fqid":"com-snaplogic-snaps-databricks-multiexecute_1-UNKNOWN","class_id":"com-snaplogic-snaps-databricks-multiexecute","class_version":1,"instance_fqid":"563f5916-c307-4270-b99e-f507174a3f14_1","instance_id":"563f5916-c307-4270-b99e-f507174a3f14","instance_version":1,"property_map":{"account":{"account_ref":{"value":{"label":{"value":"Databricks_EMEA-SE_sql-warehouse-SERVERLESS","label":"../../shared/Databricks_EMEA-SE_sql-warehouse-SERVERLESS","expression":false},"ref_class_id":{"value":"com-snaplogic-snap-api-sql-accounts-databricks-databricksdatabaseaccount"},"ref_id":{"value":"0a223ce0-a017-4f3d-b0d9-14e768c30c30","expression":false}}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"output":{"output0":{"label":{"value":"output0"},"view_type":{"value":"document"}}},"input":{"input0":{"label":{"value":"input0"},"view_type":{"value":"document"}}},"info":{"notes":{"value":null},"label":{"value":"Log changes, merge silver, audit, control, clean staging"}},"settings":{"executable_during_suggest":{"value":false},"sqlStatements":{"value":[{"sqlStatement":{"value":"\"INSERT INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes (run_id, object_name, business_key, cpq_id, op, row_hash, payload, changed_at) SELECT s.run_id, s.object_name, s.business_key, s.cpq_id, CASE WHEN t.business_key IS NULL OR t.is_deleted THEN 'I' ELSE 'U' END, s.row_hash, s.payload, current_timestamp() FROM (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \" QUALIFY row_number() OVER (PARTITION BY business_key ORDER BY cpq_id DESC) = 1) s LEFT JOIN (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (lib.cfg.sqlStr(_objectName)) + \") t ON t.business_key = s.business_key WHERE t.business_key IS NULL OR t.is_deleted OR t.row_hash <> s.row_hash\"","expression":true}},{"sqlStatement":{"value":"\"INSERT INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes (run_id, object_name, business_key, cpq_id, op, row_hash, payload, changed_at) SELECT \" + (lib.cfg.sqlStr(_runId)) + \", \" + (lib.cfg.sqlStr(_objectName)) + \", t.business_key, t.cpq_id, 'D', t.row_hash, t.payload, current_timestamp() FROM (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (lib.cfg.sqlStr(_objectName)) + \" AND NOT is_deleted) t LEFT ANTI JOIN (SELECT business_key FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \") s ON t.business_key = s.business_key WHERE \" + ($allow ? 'true' : 'false')","expression":true}},{"sqlStatement":{"value":"\"MERGE INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows t USING (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \" AND object_name = \" + (lib.cfg.sqlStr(_objectName)) + \") c ON t.object_name = c.object_name AND t.business_key = c.business_key WHEN MATCHED AND c.op = 'D' THEN UPDATE SET t.is_deleted = true, t.deleted_at = c.changed_at, t.last_changed_at = c.changed_at, t.last_run_id = c.run_id WHEN MATCHED THEN UPDATE SET t.cpq_id = c.cpq_id, t.row_hash = c.row_hash, t.payload = c.payload, t.is_deleted = false, t.deleted_at = NULL, t.last_changed_at = c.changed_at, t.last_run_id = c.run_id WHEN NOT MATCHED AND c.op <> 'D' THEN INSERT (object_name, business_key, cpq_id, row_hash, payload, is_deleted, deleted_at, first_seen_at, last_changed_at, last_run_id) VALUES (c.object_name, c.business_key, c.cpq_id, c.row_hash, c.payload, false, NULL, c.changed_at, c.changed_at, c.run_id)\"","expression":true}},{"sqlStatement":{"value":"\"INSERT INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_audit (run_id, object_name, finished_at, status, expected_total, staged_rows, distinct_keys, inserted_rows, updated_rows, deleted_rows, would_delete, deletes_allowed, message) SELECT \" + (lib.cfg.sqlStr(_runId)) + \", \" + (lib.cfg.sqlStr(_objectName)) + \", current_timestamp(), \" + (lib.cfg.sqlStr($status)) + \", \" + ('' + $expected) + \", \" + ('' + $staged_rows) + \", \" + ('' + $distinct_keys) + \", count_if(op = 'I'), count_if(op = 'U'), count_if(op = 'D'), \" + ('' + $would_delete) + \", \" + ($allow ? 'true' : 'false') + \", \" + (lib.cfg.sqlStr($message)) + \" FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \" AND object_name = \" + (lib.cfg.sqlStr(_objectName))","expression":true}},{"sqlStatement":{"value":"\"MERGE INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_control t USING (SELECT \" + (lib.cfg.sqlStr(_objectName)) + \" AS object_name) s ON t.object_name = s.object_name WHEN MATCHED THEN UPDATE SET t.last_run_id = \" + (lib.cfg.sqlStr(_runId)) + \", t.last_run_at = current_timestamp(), t.last_status = \" + (lib.cfg.sqlStr($status)) + \", t.last_message = \" + (lib.cfg.sqlStr($message)) + \" WHEN NOT MATCHED THEN INSERT (object_name, last_run_id, last_run_at, last_status, last_message, watermark) VALUES (\" + (lib.cfg.sqlStr(_objectName)) + \", \" + (lib.cfg.sqlStr(_runId)) + \", current_timestamp(), \" + (lib.cfg.sqlStr($status)) + \", \" + (lib.cfg.sqlStr($message)) + \", NULL)\"","expression":true}},{"sqlStatement":{"value":"\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE object_name = \" + (lib.cfg.sqlStr(_objectName))","expression":true}}]},"maxRetryProp":{"value":0,"expression":false},"retryIntervalProp":{"value":1,"expression":false},"sqlQueryManagement":{"value":"Continue to execute queued queries when pipeline is stopped or if it fails"},"sessionParamsProp":{"value":[]}}},"class_build_tag":"UNKNOWN"},"68de4322-f802-4722-9646-7177b5b14313":{"class_fqid":"com-snaplogic-snaps-transform-groupbyn_1-UNKNOWN","class_id":"com-snaplogic-snaps-transform-groupbyn","class_version":1,"instance_fqid":"68de4322-f802-4722-9646-7177b5b14313_1","instance_id":"68de4322-f802-4722-9646-7177b5b14313","instance_version":1,"property_map":{"account":{"account_ref":{"value":{}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"output":{"output0":{"label":{"value":"output0"},"view_type":{"value":"document"}}},"input":{"input0":{"label":{"value":"input0"},"view_type":{"value":"document"}}},"info":{"notes":{"value":null},"label":{"value":"Wait for all statements"}},"sett